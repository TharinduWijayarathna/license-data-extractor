# Application
APP_ENV=development
APP_DEBUG=true
FLIGHT_BASE_URL=/
APP_TIMEZONE=UTC

# Database — env wins over config.php for these keys when set
# Drivers: sqlite | mysql | (empty to disable)
DB_DRIVER=sqlite
DB_HOST=localhost
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Absolute or project-relative path for SQLite
DB_SQLITE_PATH=

# Licence extraction agent (php runway licences:process)
GEMINI_API_KEY=
# Defaults to gemini-3.8-flash (see app/config/config.php)
GEMINI_MODEL=
# Optional overrides, e.g. a synced OneDrive folder
LICENCE_INCOMING_DIR=
LICENCE_PROCESSED_DIR=
LICENCE_MASTER_XLSX=
LICENCE_LOG_FILE=
# Queue: background (default) | none (use `php runway licences:work` / cron)
LICENCE_QUEUE_DISPATCH=
# CLI php for background runs, if auto-detect fails (e.g. under php-fpm)
LICENCE_PHP_BINARY=
