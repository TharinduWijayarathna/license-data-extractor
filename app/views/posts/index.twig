{% extends 'layout.twig' %}

{% block title %}Posts — Licence Extractor{% endblock %}

{% block body %}
<div class="panel p-6">
    <h1 class="text-xl font-semibold">Posts</h1>
    <p class="mt-1 text-sm text-muted">Loaded via ActiveRecord from SimplePdo (run <code class="font-mono">php runway migrate</code> if empty).</p>
    {% if posts is empty %}
        <p class="mt-4 text-sm">No posts yet.</p>
    {% else %}
        <ul class="mt-4 divide-y divide-line">
            {% for post in posts %}
                <li class="py-3">
                    <a class="font-medium text-accent hover:underline" href="{{ base_url }}posts/{{ post.id }}">{{ post.title }}</a>
                    <div class="text-xs text-muted">#{{ post.id }}{% if post.created_at %} · {{ post.created_at }}{% endif %}</div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
