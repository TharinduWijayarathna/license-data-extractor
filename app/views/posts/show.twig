{% extends 'layout.twig' %}

{% block title %}{{ post.title }} — Licence Extractor{% endblock %}

{% block body %}
<div class="panel p-6">
    <a class="text-sm text-accent hover:underline" href="{{ base_url }}posts">← All posts</a>
    <h1 class="mt-3 text-xl font-semibold">{{ post.title }}</h1>
    <p class="mt-2">{{ post.content }}</p>
    {% if post.created_at %}
        <p class="mt-4 text-xs text-muted">Created {{ post.created_at }}</p>
    {% endif %}
</div>
{% endblock %}
