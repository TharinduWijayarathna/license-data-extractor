<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Licence Register{% endblock %}</title>
    {# Built from resources/css/app.css with `npm run build` #}
    <link rel="preload" href="{{ base_url }}assets/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ base_url }}assets/app.css">
    <link rel="icon" href="{{ base_url }}favicon.svg" type="image/svg+xml">
    {% block head %}{% endblock %}
</head>
<body class="min-h-screen bg-paper font-sans text-[14px] text-ink">
    <header class="border-b border-line bg-surface">
        <div class="mx-auto flex h-14 max-w-[1400px] items-center justify-between gap-6 px-5 lg:px-8">
            <a href="{{ base_url }}" class="flex items-center gap-2.5">
                {# Mark: a ruled register page #}
                <svg class="size-6 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                    <rect width="24" height="24" rx="5" class="fill-ink"/>
                    <path d="M7 8h10M7 12h10M7 16h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/>
                    <circle cx="17" cy="16" r="1.6" class="fill-[#7fc4ad]"/>
                </svg>
                <span class="text-[15px] font-semibold tracking-tight whitespace-nowrap">Licence Register</span>
                <span class="hidden border-l border-line pl-2.5 font-mono text-[11px] text-faint sm:inline">vendor licences → xlsx</span>
            </a>
            <div class="flex items-center gap-2">
                {% block header_actions %}{% endblock %}
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-[1400px] px-5 py-8 lg:px-8">
        {% block body %}{% endblock %}
    </main>

    {% block scripts %}{% endblock %}
</body>
</html>
