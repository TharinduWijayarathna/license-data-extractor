<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.4/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" recordTestRunHistory="false">
  <testsuites>
    <testsuite name="Flight Skeleton">
      <directory>tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">app</directory>
    </include>
    <exclude>
      <directory>app/views</directory>
      <directory>app/cache</directory>
      <directory>app/log</directory>
      <directory>app/config</directory>
    </exclude>
  </source>
</phpunit>
