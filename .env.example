# Application — set APP_DEBUG=false in production
APP_DEBUG=true
FLIGHT_BASE_URL=/
APP_TIMEZONE=UTC

# Queue database (SQLite). Empty path = database.sqlite in the project root.
# MySQL and other optional overrides are listed in README.md ("Configuration").
DB_DRIVER=sqlite
DB_SQLITE_PATH=

# Gemini key for document extraction (required) — aistudio.google.com
GEMINI_API_KEY=

# How processing starts after upload:
#   background (default) — detached `php runway licences:process` run
#   inline — in the web request after the response is sent; use on cPanel / shared hosting
#   none — leave jobs to `php runway licences:work` or cron
LICENCE_QUEUE_DISPATCH=

# REST API (/api/v1) — comma-separated keys; empty disables the API.
# Generate one with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
API_KEYS=
